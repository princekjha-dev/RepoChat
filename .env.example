# ══════════════════════════════════════════════════════
# RepoChat AI — Root Environment Configuration
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider (at least one required) ──────────────
# Priority order: Groq → Anthropic → OpenRouter
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GitHub (optional — increases rate limits) ─────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Model Selection ────────────────────────────────────
# Groq: llama-3.3-70b-versatile | mixtral-8x7b-32768
# OpenRouter: meta-llama/llama-3.3-70b-instruct | anthropic/claude-3.5-sonnet
# Anthropic: claude-3-5-sonnet-20241022
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Backend Server ─────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=true

# ── Frontend (Vite) ────────────────────────────────────
VITE_API_URL=http://localhost:5000

# ── Docker ─────────────────────────────────────────────
# Only needed when using docker-compose
# VITE_API_URL=http://backend:5000

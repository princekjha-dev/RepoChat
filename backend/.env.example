# ══════════════════════════════════════════════════════
# RepoChat AI — Environment Configuration
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── LLM API Keys (at least one required for chat/review) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GitHub Token (optional but recommended for higher rate limits) ──
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Model Configuration ──
# For OpenRouter: e.g., meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet
# For Groq: e.g., llama-3.3-70b-versatile
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Server Configuration ──
HOST=0.0.0.0
PORT=5000
DEBUG=true

# ── CORS ──
CORS_ORIGINS=*
